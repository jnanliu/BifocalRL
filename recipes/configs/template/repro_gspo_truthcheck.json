{
  "name": "repro-gspo-truthcheck",
  "_doc": "Single-model GSPO reproduction baseline with ground-truth reward. Matches HACRL GSPO numeric settings (lr, epsilon, KL, temperature).",
  "models": {
    "policy": "/path/to/your/model",
    "reward": null
  },
  "dataset": {
    "key": "math_lighteval",
    "max_samples": null,
    "system_prompt": null,
    "prompt_mode": null,
    "instruction_suffix": null,
    "enable_thinking": "false",
    "problems_per_step": 128,
    "shuffle": true
  },
  "generation": {
    "num_generations": 8,
    "temperature": 1.0,
    "top_p": 1.0,
    "repetition_penalty": 1.0,
    "max_completion_length": 2048,
    "max_prompt_length": 1024
  },
  "scoring": {
    "scoring_batch_size": 4,
    "logps_batch_size": 16
  },
  "reward": {
    "mode": "truth",
    "scorer": "hacrl_math_boxed",
    "beta": 0.0
  },
  "training": {
    "num_gpus": 2,
    "max_steps": 4,
    "start_step": 1,
    "per_device_batch_size": 2,
    "gradient_accumulation_steps": 16,
    "learning_rate": "1e-6",
    "warmup_ratio": 0.1,
    "lr_scheduler": "cosine",
    "weight_decay": 0.1,
    "torch_dtype": "bfloat16",
    "seed": 7,
    "bf16": true,
    "gradient_checkpointing": true,
    "num_iterations": 1,
    "epsilon": 0.2,
    "objective_mode": "gspo",
    "is_length_norm": "mean",
    "self_update_epsilon_low": 0.0003,
    "self_update_epsilon_high": 0.0004,
    "max_grad_norm": 1.0,
    "accelerator_config": "zero3"
  },
  "debug": {
    "pipeline_truthcheck": true
  },
  "vllm": {
    "use_offline": true,
    "port": 7900,
    "gpu": 0,
    "tensor_parallel_size": 1,
    "gpu_memory_utilization": 0.9,
    "dtype": "bfloat16",
    "max_model_len": 4096,
    "max_num_seqs": 32,
    "max_num_batched_tokens": 8192,
    "chunked_prefill": true,
    "start_timeout": 900
  },
  "output": {
    "keep_all_checkpoints": true,
    "checkpoint_dir": "outputs/repro-gspo-truthcheck/latest_checkpoint",
    "lighteval_prefix": "outputs/lighteval/repro-gspo-truthcheck",
    "zeroeval_root": "outputs/zeroeval/repro-gspo-truthcheck",
    "ttrl_dir": "outputs/ttrl_eval/repro-gspo-truthcheck"
  },
  "eval": {
    "max_new_tokens": 4096,
    "local_datasets_root": "/data/wh/czj/test/datasets",
    "lighteval": {
      "enabled": false,
      "tasks": "math_500,gsm8k",
      "prompt_mode": "system",
      "system_prompt": null,
      "custom_tasks": "eval.lighteval.custom_tasks.offline_patch",
      "data_parallel_size": 1
    },
    "zeroeval": {
      "enabled": false,
      "tasks": "cruxeval",
      "repo_dir": "third_party/ZeroEval",
      "tp_size": 1,
      "batch_size": 400,
      "max_tokens": 4096,
      "gpu_memory_utilization": 0.95,
      "max_samples": 800
    },
    "hacrl": {
      "enabled": true,
      "tasks": "math_500,gsm8k",
      "scorer": "hacrl_math_boxed",
      "num_generations": 1,
      "max_samples": null,
      "use_offline": true,
      "gpu_memory_utilization": 0.9,
      "tensor_parallel_size": 1,
      "dtype": "bfloat16",
      "temperature": 0.0,
      "top_p": 1.0
    },
    "ttrl": {
      "enabled": false,
      "tasks": "math_ttt,aime_ttt",
      "scorer": "ttrl_math",
      "num_generations": 1,
      "max_samples": null,
      "prompt_mode": "bare",
      "temperature": 0.0,
      "top_p": 1.0,
      "gpu_memory_utilization": 0.9,
      "tensor_parallel_size": 1,
      "dtype": "bfloat16"
    }
  }
}
