{
  "name": "retokenize-intuitor",
  "_doc": "Retokenize pipeline with ground-truth reward. Peer responses are retokenized into the training model's vocabulary; IS ratio uses A/A_old instead of A/B_old. HACPO IS tricks (stopgrad scaling, asymmetric clip, stepwise clip, IS reweight) are all disabled. Peer loss uses PPO-clip (same as self) scaled by capability weight.",
  "models": {
    "model_a": "/home/jizeyu26/jzy/7_co_learning/test/models/Qwen3-1.7B-Base",
    "model_b": "/home/jizeyu26/jzy/7_co_learning/test/models/Qwen3-4B-Base"
  },
  "dataset": {
    "key": "math_lighteval",
    "max_samples": null,
    "system_prompt": null,
    "prompt_mode": null,
    "instruction_suffix": null,
    "enable_thinking": "false",
    "problems_per_step": 128,
    "shuffle": true
  },
  "generation": {
    "num_generations_per_model": 4,
    "temperature": 1.0,
    "top_p": 1.0,
    "repetition_penalty": 1.0,
    "max_completion_length": 2048,
    "max_prompt_length": 1024
  },
  "scoring": {
    "scoring_batch_size": 4,
    "logps_batch_size": 16
  },
  "reward": {
    "method": "self_scores",
    "beta": 0.001
  },
  "training": {
    "num_gpus": 2,
    "max_steps": 4,
    "start_step": 1,
    "learning_rate": "1e-6",
    "warmup_ratio": 0.0,
    "weight_decay": 0.01,
    "lr_scheduler": "constant",
    "seed": 7,
    "num_iterations": 1,
    "epsilon": 0.2,
    "objective_mode": "gspo",
    "co_update_mode": "two_phase",
    "is_length_norm": "mean",
    "is_strict_old_for_peer": true,
    "capability_weight_mode": "reward_ratio",
    "capability_ratio_smoothing": "last_k",
    "capability_ratio_k": 5,
    "model_ids": [
      "a",
      "b"
    ],
    "accelerator_config": "zero3",
    "max_grad_norm": 1.0,
    "gradient_accumulation_steps": 512,
    "per_device_batch_size": 2,
    "gradient_accumulation_steps_a": 512,
    "gradient_accumulation_steps_b": 512,
    "per_device_batch_size_a": 2,
    "per_device_batch_size_b": 2,
    "learn_config": {
      "a": {
        "own": 4,
        "other": 4
      },
      "b": {
        "own": 4,
        "other": 4
      },
      "selection": "first"
    },
    "self_update_epsilon_low": 0.2,
    "self_update_epsilon_high": 0.2,
    "peer_special_clip_asymmetric_enabled": false,
    "peer_special_clip_stepwise_enabled": false,
    "peer_special_clip_delta": 0.8,
    "peer_special_clip_delta_step": 0.025,
    "peer_is_reweight_enabled": false,
    "peer_is_reweight_alpha": 1.0,
    "stable_perf": 0,
    "gspo_surrogate_ratio_enabled": false,
    "peer_retokenize_old_logps": true,
    "peer_loss_uniform": true
  },
  "debug": {
    "pipeline_truthcheck": false
  },
  "vllm": {
    "use_offline": true,
    "port_a": 8050,
    "port_b": 8051,
    "gpu_a": 0,
    "gpu_b": 1,
    "gpu_memory_utilization": 0.9,
    "dtype": "bfloat16",
    "max_model_len": 4096,
    "max_num_seqs": 256,
    "max_num_batched_tokens": 8192,
    "chunked_prefill": true,
    "start_timeout": 900,
    "auto_start": false,
    "auto_stop": true
  },
  "output": {
    "keep_all_checkpoints": true,
    "checkpoint_dir": "outputs/retokenize-intuitor/latest_checkpoint",
    "lighteval_prefix": "outputs/lighteval/retokenize-intuitor",
    "zeroeval_root": "outputs/zeroeval/retokenize-intuitor",
    "ttrl_dir": "outputs/ttrl_eval/retokenize-intuitor"
  },
  "eval": {
    "max_new_tokens": 4096,
    "local_datasets_root": "/home/jizeyu26/jzy/7_co_learning/test/datasets",
    "lighteval": {
      "enabled": true,
      "tasks": "math_500,gsm8k",
      "prompt_mode": "system",
      "system_prompt": null,
      "custom_tasks": "eval.lighteval.custom_tasks.offline_patch",
      "data_parallel_size": 1
    },
    "zeroeval": {
      "enabled": false,
      "tasks": "cruxeval",
      "repo_dir": "third_party/ZeroEval",
      "tp_size": 1,
      "batch_size": 400,
      "max_tokens": 4096,
      "gpu_memory_utilization": 0.95,
      "max_samples": 800
    },
    "hacrl": {
      "enabled": false,
      "tasks": "math_500,gsm8k",
      "scorer": "hacrl_math_boxed",
      "num_generations": 1,
      "max_samples": null,
      "use_offline": true,
      "gpu_memory_utilization": 0.9,
      "tensor_parallel_size": 1,
      "dtype": "bfloat16",
      "temperature": 0.0,
      "top_p": 1.0
    },
    "ttrl": {
      "enabled": false,
      "tasks": "math_ttt,aime_ttt",
      "scorer": "ttrl_math",
      "num_generations": 1,
      "max_samples": null,
      "prompt_mode": "bare",
      "temperature": 0.0,
      "top_p": 1.0,
      "gpu_memory_utilization": 0.9,
      "tensor_parallel_size": 1,
      "dtype": "bfloat16"
    }
  }
}
