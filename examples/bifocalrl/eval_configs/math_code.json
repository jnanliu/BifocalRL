{
  "dataset": ["data/math500.jsonl", "data/code_eval.jsonl"],
  "split": "train",
  "steps": 10,
  "temperature": 0.6,
  "n_samples_per_prompt": 1,
  "n_samples_per_prompt_by_datasource": {
    "math500": 1,
    "livecodebench": 8
